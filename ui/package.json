    "private": true,
    "dependencies": {
        "axios": "^1.6.0",
        "jspdf": "^3.0.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-scripts": "5.0.1",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "start": "PORT=3002 react-scripts start",
        "build": "react-scripts build",
        "test": "react-scripts test",
