OPENAI_API_KEY=CHANGE_ME
DENO_ADDR_FAMILY_PRIORITY="ipv4first"
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=CHANGE_ME
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS='["-y","@playwright/mcp","--browser=chromium","--headless"]'
MCP_SERVER_URL="http://localhost:3003/sse"
DEBUG=false
OPENAI_MODEL="gpt-4o"
OPENAI_TIMEOUT=20

# JWT Authentication
JWT_SECRET="your-secure-jwt-secret-key-here"


# Firebase Configuration (for emulator, these can be dummy values)
FIREBASE_API_KEY="demo-key-for-emulator"
FIREBASE_AUTH_DOMAIN="demo-local.firebaseapp.com"
FIREBASE_PROJECT_ID="demo-local"
FIREBASE_STORAGE_BUCKET="demo-local.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="123456789"
FIREBASE_APP_ID="1:123456789:web:abcdef1234567890"

# Firebase Emulator Configuration
USE_FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=firebase
FIREBASE_EMULATOR_PORT=4000
FIREBASE_FIRESTORE_EMULATOR_PORT=8080
FIREBASE_STORAGE_EMULATOR_PORT=9199

# Firebase Configuration
FIREBASE_API_KEY="your-api-key"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
FIREBASE_APP_ID="your-app-id"


# Firebase Performance Settings
FIRESTORE_CACHE_SIZE_MB=50
FIRESTORE_MAX_CONCURRENT_CONNECTIONS=5
FIRESTORE_PERSISTENCE=false
FIRESTORE_MAX_PAYLOAD_SIZE=1048576